{
	"name": "react-jsonschema-form-validation",
	"description": "Simple form validation using JSON Schema and AJV",
	"version": "0.7.0",
	"author": "53JS",
	"license": "MIT",
	"scripts": {
		"start": "vite",
		"build": "vite build",
		"clean": "rm -rf dist",
		"dist": "yarn clean && yarn dist:css && yarn dist:js && yarn dist:types && yarn minify:css",
		"dist:css": "sass --style=expanded --no-source-map src/lib/styles/main.scss dist/$npm_package_name.css",
		"dist:js": "vite build --config vite.lib.config.js",
		"dist:types": "tsc -p tsconfig.build.json",
		"minify:css": "cleancss --level 1 --source-map --source-map-inline-sources --output dist/$npm_package_name.min.css dist/$npm_package_name.css",
		"test": "yarn test:runtime && yarn test:types",
		"test:runtime": "vitest run",
		"test:runtime:watch": "vitest",
		"test:types": "bash test-types/check-matrix.sh",
		"type-check": "tsc -p tsconfig.json",
		"lint": "eslint src vite.config.js vite.lib.config.js vitest.config.js",
		"prepublishOnly": "yarn test:runtime --bail 1 && yarn test:types && yarn dist"
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not ie <= 11",
		"not op_mini all"
	],
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./providers/ajv": {
			"types": "./dist/providers/ajv/index.d.ts",
			"default": "./dist/providers/ajv/index.js"
		},
		"./package.json": "./package.json",
		"./dist/react-jsonschema-form-validation.css": "./dist/react-jsonschema-form-validation.css",
		"./dist/react-jsonschema-form-validation.min.css": "./dist/react-jsonschema-form-validation.min.css"
	},
	"typesVersions": {
		"*": {
			"providers/ajv": [
				"dist/providers/ajv/index.d.ts"
			]
		}
	},
	"sideEffects": [
		"*.css"
	],
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist",
		"README.md"
	],
	"homepage": "https://53js.github.io/react-jsonschema-form-validation",
	"bugs": {
		"url": "https://github.com/53js/react-jsonschema-form-validation/issues"
	},
	"repository": "github:53js/react-jsonschema-form-validation",
	"dependencies": {
		"@types/json-schema": "^7.0.15",
		"ajv": "^8.17.0",
		"ajv-formats": "^3",
		"classnames": "^2.2.6",
		"memoize-one": "^5.1.1",
		"prop-types": "^15.7.2"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/prop-types": "^15.7.15",
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^4.3.0",
		"@vitest/coverage-istanbul": "^3.2.6",
		"babel-eslint": "10.0.3",
		"bootstrap": "^4.4.1",
		"clean-css-cli": "^4.3.0",
		"eslint": "^6.1.0",
		"eslint-config-53js": "^1.2.0",
		"eslint-config-airbnb": "^18.0.1",
		"eslint-plugin-import": "2.20.1",
		"eslint-plugin-jest": "^23.6.0",
		"eslint-plugin-jsx-a11y": "6.2.3",
		"eslint-plugin-react": "7.18.3",
		"eslint-plugin-react-hooks": "1.7.0",
		"jsdom": "^25.0.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-prism": "^4.3.2",
		"react-router-dom": "^5.1.2",
		"react-select": "^3.0.8",
		"reactstrap": "^8.4.1",
		"sass": "^1.101.7",
		"typescript": "^6.0.3",
		"vite": "^6.4.3",
		"vitest": "^3.2.6",
		"zod": "^4"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"resolutions": {
		"**/vite": "^6.4.3"
	},
	"keywords": [
		"JSON",
		"ajv",
		"component",
		"form",
		"input",
		"html5",
		"json-schema",
		"json-schema-validation",
		"json-schema-validator",
		"jsonschema",
		"react",
		"react-component",
		"sanitization",
		"sanitize",
		"sanitizer",
		"schema",
		"validate",
		"validation",
		"validator",
		"ui"
	]
}
