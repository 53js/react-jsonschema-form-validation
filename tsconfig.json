{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "lib": [
      "ES2019",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true
  },
  "include": [
    "src/lib/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "**/*.test.js",
    "**/__mocks__/**",
    "**/__snapshots__/**",
    "node_modules",
    "dist",
    "docs",
    "build"
  ]
}
